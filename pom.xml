<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>net.rabbitware.config</groupId>
    <artifactId>parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.12.2</junit.version>
        <surefire.version>3.5.4</surefire.version>
    </properties>

    <modules>
        <module>config</module>
        <module>example</module>
        <module>benchmark</module>
        <module>plugin-api</module>
        <module>plugin-prefix</module>
        <module>plugin-json</module>
        <module>plugin-xml</module>
        <module>plugin-yaml</module>
        <module>plugin-jdbc</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>net.rabbitware.config</groupId>
                <artifactId>config</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.rabbitware.config</groupId>
                <artifactId>plugin-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.rabbitware.config</groupId>
                <artifactId>plugin-prefix</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.rabbitware.config</groupId>
                <artifactId>plugin-json</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.rabbitware.config</groupId>
                <artifactId>plugin-xml</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.rabbitware.config</groupId>
                <artifactId>plugin-yaml</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.rabbitware.config</groupId>
                <artifactId>plugin-jdbc</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>2.0.18</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-simple</artifactId>
                <version>2.0.18</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-api</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-params</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-engine</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire.version}</version>
                    <configuration>
                        <!--
                            Run the tests on the classpath rather than the
                            module path. The tests live in the same package as
                            the code under test, which the module system treats
                            as a split package.
                        -->
                        <useModulePath>false</useModulePath>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
