{
    "files.associations": {
        "rwconfig": "rwconfig"
    },

    "[rwconfig]": {
        "editor.bracketPairColorization.enabled": false,
        "editor.matchBrackets": "never"
    },
    "cSpell.words": [
        "getb",
        "getbl",
        "getd",
        "getdl",
        "geti",
        "getil",
        "getl",
        "getll",
        "getsl",
        "hocon",
        "rabbitware",
        "rwconfig",
        "typesafe"
    ],
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.compile.nullAnalysis.mode": "automatic",
    "claudeCode.preferredLocation": "sidebar",
    "editor.wordWrap": "on"
}
